API_CORS_ORIGIN=*
API_DOCUMENTATION_ENABLED=true
# --- Object storage (SeaweedFS) ---
# Used by the indexer/DVC and to create the SeaweedFS login
S3_REGION=eu-west-1
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_DATA_BUCKET_PATH=resources
S3_DATA_BUCKET_NAME=rag-search
FS_DATA_DIRECTORY_PATH=/app
S3_ACCESS_KEY_ID=changeme-s3-access-key
S3_SECRET_ACCESS_KEY=changeme-s3-secret-key
# Used by S3-Ferry v1.1.3 - keys must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
S3_DEFAULT_REGION=eu-west-1
S3_DEFAULT_ENDPOINT_URL=http://seaweedfs:8333
S3_DEFAULT_ACCESS_KEY_ID=changeme-s3-access-key
S3_DEFAULT_SECRET_ACCESS_KEY=changeme-s3-secret-key
S3_DEFAULT_DATA_BUCKET_NAME=rag-search
S3_DEFAULT_DATA_BUCKET_PATH=resources
S3_DEFAULT_FS_DATA_DIRECTORY_PATH=/app
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_USERS_ALLOW_SIGN_UP=false
PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dbadmin
POSTGRES_DB=rag-search
NEXTAUTH_URL=http://localhost:3005
DATABASE_URL=postgresql://postgres:dbadmin@rag-search-db:5432/langfuse-db
SALT=changeme
ENCRYPTION_KEY=changeme
NEXTAUTH_SECRET=changeme
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_CLUSTER_ENABLED=false
LANGFUSE_USE_AZURE_BLOB=false
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=rag-search
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=changeme-s3-access-key
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=changeme-s3-secret-key
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=langfuse/events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=rag-search
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=changeme-s3-access-key
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=changeme-s3-secret-key
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=langfuse/media/
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=rag-search
LANGFUSE_S3_BATCH_EXPORT_PREFIX=langfuse/exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://seaweedfs:8333
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=changeme-s3-access-key
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=changeme-s3-secret-key
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=
# --- Redis-compatible store (Dragonfly) ---
# Used by the LLM service (sessions, history, API cache in db 1) and Langfuse (queues in db 0)
REDIS_HOST=dragonfly
REDIS_PORT=6379
REDIS_AUTH=myredissecret
REDIS_TLS_ENABLED=false
REDIS_TLS_CA=/certs/ca.crt
REDIS_TLS_CERT=/certs/redis.crt
REDIS_TLS_KEY=/certs/redis.key
REDIS_SESSION_DB=1
# Optional prefix for app keys; leave empty (only needed if the app shares db 0 with Langfuse)
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=3
REDIS_MAX_CONNECTIONS=100
DRAGONFLY_THREADS=2
DRAGONFLY_MAXMEMORY=1gb
DRAGONFLY_MEM_LIMIT=1280m
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=
VAULT_ADDR=http://localhost:8200
S3_FERRY_URL=http://rag-s3-ferry:3000/v1/files/copy
DATASETS_PATH=/app/datasets
METADATA_FILENAME=processed-metadata.json
OPENSEARCH_USERNAME=changeme
OPENSEARCH_PASSWORD=changeme