    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "description": "Resets on every restart; the 'Dragonfly restarted' alert watches this.",
      "datasource": {
        "type": "loki",
        "uid": "loki-datasource"
      },
      "interval": "1m",
