          },
          "queryType": "range",
          "expr": "max_over_time({service=\"dragonfly-metrics\"} | json | line_format \"{{.message}}\" | json | __error__=\"\" | unwrap used_memory [$__interval])",
          "legendFormat": "used_memory"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki-datasource"
          },
          "queryType": "range",
          "expr": "max_over_time({service=\"dragonfly-metrics\"} | json | line_format \"{{.message}}\" | json | __error__=\"\" | unwrap maxmemory [$__interval])",
          "legendFormat": "maxmemory"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki-datasource"
          },
          "queryType": "range",
          "expr": "max_over_time({service=\"dragonfly-metrics\"} | json | line_format \"{{.message}}\" | json | __error__=\"\" | unwrap used_memory_rss [$__interval])",
          "legendFormat": "process RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
