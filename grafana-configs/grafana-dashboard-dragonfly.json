{
  "id": null,
  "uid": "dragonfly-store",
  "title": "Dragonfly",
  "tags": [
    "rag-module",
    "dragonfly"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory used (% of maxmemory)",
      "description": "Writes are refused at 100% (noeviction). Alerts fire at 70% and 85%.",
      "datasource": {
        "type": "loki",
        "uid": "loki-datasource"
      },
      "interval": "1m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-datasource"
          },
          "queryType": "range",
          "expr": "max_over_time({service=\"dragonfly-metrics\"} | json | line_format \"{{.message}}\" | json | __error__=\"\" | unwrap memory_used_pct [$__interval])",
          "legendFormat": "memory used %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory used vs maxmemory",
      "description": "RSS is the real process memory; it must stay below the container memory limit.",
      "datasource": {
        "type": "loki",
        "uid": "loki-datasource"
      },
      "interval": "1m",
      "gridPos": {
        "h": 8,
        "w": 12,
